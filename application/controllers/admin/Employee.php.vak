			        <FloorNo>string</FloorNo>
			        <UnitNo>string</UnitNo>
			        <ParkingNo>string</ParkingNo>
			        <StaffNo>'.$data['id'].'</StaffNo>
			        <Title></Title>
			        <Position></Position>
			        <NRIC></NRIC>
			        <Passport></Passport>
			        <Race></Race>
			        <DOB>1950/08/28</DOB>
