	public function getData()
	{
		$data = $this->Model_Admin->getDataEmployee();
		if($data['error'] == null){
			echo response("success", $data['data'], "Get success");
		}else{
			echo response("fail", $data, "Get failed");
		}
	}
	public function getDepartement()
	{
